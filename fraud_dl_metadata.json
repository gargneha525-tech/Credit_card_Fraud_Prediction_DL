{
    "model_name": "Credit Card Fraud Detection DNN",
    "model_type": "TensorFlow/Keras",
    "target_column": "Class",
    "class_mapping": {
        "0": "Legitimate transaction",
        "1": "Fraudulent transaction"
    },
    "feature_columns": [
        "Time",
        "V1",
        "V2",
        "V3",
        "V4",
        "V5",
        "V6",
        "V7",
        "V8",
        "V9",
        "V10",
        "V11",
        "V12",
        "V13",
        "V14",
        "V15",
        "V16",
        "V17",
        "V18",
        "V19",
        "V20",
        "V21",
        "V22",
        "V23",
        "V24",
        "V25",
        "V26",
        "V27",
        "V28",
        "Amount"
    ],
    "input_dimension": 30,
    "constant_features_removed": [],
    "random_state": 42,
    "train_fraction": 0.7,
    "validation_fraction": 0.15,
    "test_fraction": 0.15,
    "imbalance_strategy": "class_weight",
    "threshold_selection": "maximum validation F1-score",
    "batch_size": 2048,
    "maximum_epochs": 50,
    "tensorflow_version": "2.21.0",
    "scikit_learn_version": "1.9.1",
    "model_filename": "best_fraud_dl_model.keras",
    "preprocessor_filename": "fraud_preprocessor.joblib",
    "threshold_filename": "fraud_dl_threshold.json"
}